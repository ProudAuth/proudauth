# Run ./init-env.sh to generate .env with private credentials and mode 0600.
COMPOSE_PROJECT_NAME=proudauth-image
PROUDAUTH_IMAGE=proudauth:0.2.0-local
PROUDAUTH_PLATFORM=linux/arm64
POSTGRES_IMAGE=postgres:18-alpine
SWAGGER_IMAGE=docker.swagger.io/swaggerapi/swagger-ui:latest
BIND_ADDRESS=127.0.0.1
PROUDAUTH_PORT=8080
PROUDAUTH_OPERATOR_PORT=9090
SWAGGER_PORT=8081
PROUDAUTH_PUBLIC_ORIGIN=http://localhost:8080
# Optional HTTPS tunnel profile: config.tunnel.yaml; see README.md.
PROUDAUTH_CONFIG_FILE=config.yaml
PROUDAUTH_TRUSTED_PROXIES=
POSTGRES_USER=proudauth
POSTGRES_DB=proudauth
POSTGRES_PASSWORD=replace-with-a-random-hex-password
ROOT_KEY_VALUE=replace-with-64-random-hex-digits

# ProudAuth production. Fill every empty value, then: docker compose up -d --wait
# Same variables as development (../dev/.env); docker-compose.yaml fixes
# production mode, a strict Host check and SMTP delivery.
# After filling it: chmod 600 .env, and never commit or share the filled file.

# Release image; pin the version you deploy.
PROUDAUTH_IMAGE=ghcr.io/proudbase/proudauth:0.2.0-alpha.2

# Your HTTPS address, served by your reverse proxy, e.g. https://id.example.com
# It becomes the issuer of the realm: choose it once and keep it.
PROUDAUTH_PUBLIC_ORIGIN=
# IP/CIDR of your reverse proxy as seen by the container (comma-separated);
# empty trusts no forwarding headers.
PROUDAUTH_TRUSTED_PROXIES=

# Your PostgreSQL database (17 and 18 are tested). The user must own the
# database: migrations run with it.
# Same machine: host.docker.internal. Example:
# postgres://proudauth:PASSWORD@db.example.com:5432/proudauth?sslmode=require
PROUDAUTH_DATABASE_URL=

# 64 hexadecimal characters: openssl rand -hex 32
# Back it up with the database; a lost key makes stored keys unreadable.
PROUDAUTH_ROOT_KEY=

# Your SMTP relay. TLS: starttls (port 587) or implicit (port 465).
PROUDAUTH_SMTP_HOST=
PROUDAUTH_SMTP_PORT=587
PROUDAUTH_SMTP_TLS=starttls
PROUDAUTH_SMTP_USERNAME=
PROUDAUTH_SMTP_PASSWORD=
PROUDAUTH_EMAIL_FROM=

# info, warn or error.
PROUDAUTH_LOG_LEVEL=info

# Host address and port the reverse proxy connects to.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080

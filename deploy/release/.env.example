# Production: copy to .env, set your HTTPS issuer and SMTP values, then ./init.sh.
# Values are literal; do not use shell commands or ${...} interpolation.
COMPOSE_PROJECT_NAME=proudauth
PROUDAUTH_IMAGE=ghcr.io/proudbase/proudauth:0.2.0-alpha.1
POSTGRES_IMAGE=postgres:18.6
DEPLOYMENT_PROFILE=production
PROUDAUTH_PUBLIC_ORIGIN=https://identity.example.com
PROUDAUTH_REALM=main
PROUDAUTH_TRUSTED_PROXIES=
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
OPERATOR_PORT=9090
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POOL_MAX_CONNECTIONS=20
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=proudauth
EMAIL_FROM=no-reply@example.com
LOG_LEVEL=info

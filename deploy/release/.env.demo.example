# Local evaluation only: HTTP, insecure development cookies and private email sink.
COMPOSE_PROJECT_NAME=proudauth-demo
PROUDAUTH_IMAGE=ghcr.io/proudbase/proudauth:0.2.0-alpha.1
POSTGRES_IMAGE=postgres:18.6
DEPLOYMENT_PROFILE=demo
PROUDAUTH_PUBLIC_ORIGIN=http://localhost:8080
PROUDAUTH_REALM=main
PROUDAUTH_TRUSTED_PROXIES=
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
OPERATOR_PORT=9090
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POOL_MAX_CONNECTIONS=20
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
EMAIL_FROM=
LOG_LEVEL=info

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.proudbase.com/schemas/hooks/registration.eligibility.request.v1.json",
  "title": "registration.eligibility hook request (contract v1)",
  "description": "Sent before any account or message is created. Security decision: any refusal or failure denies (fail closed, EXT-012).",
  "type": "object",
  "required": [
    "hook_kind",
    "realm_id",
    "registration",
    "client_id"
  ],
  "properties": {
    "hook_kind": {
      "const": "registration.eligibility",
      "description": "The hook kind."
    },
    "realm_id": {
      "$ref": "common.v1.json#/$defs/realm_id"
    },
    "registration": {
      "type": "object",
      "required": [
        "email",
        "email_domain",
        "invited",
        "creates_organization"
      ],
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "description": "Canonical e-mail address being registered."
        },
        "email_domain": {
          "type": "string",
          "description": "Its domain."
        },
        "username": {
          "type": "string",
          "description": "Requested username (may be empty)."
        },
        "invited": {
          "type": "boolean",
          "description": "The registration redeems an invitation."
        },
        "creates_organization": {
          "type": "boolean",
          "description": "The registration creates an organization."
        },
        "guest_upgrade": {
          "type": "boolean",
          "description": "A guest account is being upgraded to a full account."
        }
      }
    },
    "client_id": {
      "type": "string",
      "description": "OAuth client_id the registration started from."
    }
  },
  "additionalProperties": false,
  "x-hook-kind": "registration.eligibility",
  "x-contract-version": 1,
  "examples": [
    {
      "hook_kind": "registration.eligibility",
      "realm_id": "rlm_01jbxe2ktygrnsjxt1j8etsahj",
      "client_id": "web-bff",
      "registration": {
        "email": "eve@example.com",
        "email_domain": "example.com",
        "username": "",
        "invited": false,
        "creates_organization": false
      }
    }
  ]
}
